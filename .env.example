# Copy to .env (never commit .env). Fly has the same values as secrets (flyctl secrets set ...).

# Telegram bot: create with @BotFather. Leave the chat ID empty at first;
# send /start to the bot and it will tell you the value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# STR_MODEL=claude-opus-5-5

# Google Calendar (personal account): `.venv/bin/python bot/google_auth.py <client_secret.json>`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# PROPERTY_CALENDAR_IDS=leomproperty@gmail.com

# Reservation feeds (secret URLs). Airbnb: Calendar → Availability → Connect calendars → Export.
# VRBO: Calendar → Import/Export → Export calendar.
AIRBNB_ICAL_URL=
VRBO_ICAL_URL=

# Uptime monitoring: healthchecks.io ping URL (5 min period)
HC_PING_URL=
